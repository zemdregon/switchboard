{
  // Shared markdownlint-cli2 configuration.
  // The blocking CI job lints every Markdown file, including docs/ (see
  // .github/workflows/docs-lint.yml). Installed dependencies are ignored so a
  // local run matches CI.
  "ignores": ["node_modules/**"],
  "config": {
    "default": true,
    // Prose documents with long lines and wide tables are common in
    // research notes; keep the rule but allow long lines in tables and code.
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false
    },
    // Duplicate headings are normal across research sections.
    "MD024": {
      "siblings_only": true
    },
    // Inline HTML is used for attribution comments in PR templates.
    "MD033": false
  }
}
