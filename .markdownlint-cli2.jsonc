{
  // Shared markdownlint-cli2 configuration.
  // The blocking CI job lints every Markdown file except docs/ (see
  // .github/workflows/docs-lint.yml). docs/ is linted by a separate,
  // non-blocking advisory job because it has existing lint debt that
  // is not being fixed in this pass.
  "config": {
    "default": true,
    // Prose documents with long lines and wide tables are common in
    // research notes; keep the rule but allow long lines in tables and code.
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false
    },
    // Duplicate headings are normal across research sections.
    "MD024": {
      "siblings_only": true
    },
    // Inline HTML is used for attribution comments in PR templates.
    "MD033": false
  }
}
